rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // 3. Collection Rules
    
    // Messages (Contact Form)
    match /messages/{messageId} {
      // Anyone can send a message
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      
      // Reading messages is restricted (only via Firebase Console for now)
      allow read, update, delete: if false;
    }

    // 4. Validation Helpers
    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'content', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 5 && data.email.size() <= 100 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             data.createdAt == request.time;
    }
  }
}
